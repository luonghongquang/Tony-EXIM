    <style>
        /* ====== RESET & BASE ====== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-body: #121212;
            --bg-sidebar: #1e1e1e;
            --bg-card: #2b2b2b;
            --bg-card-hover: #3a3a3a;
            --text-primary: #f5f5f5;
            --text-secondary: #b0b0b0;
            --text-muted: #7a7a7a;
            --accent: #ffdb70;
            --accent-dark: #d4b24a;
            --border-light: #3a3a3a;
            --shadow: 0 16px 30px -12px rgba(0, 0, 0, 0.5);
            --radius: 20px;
            --radius-sm: 14px;
            --font: 'Poppins', sans-serif;
        }

        body {
            font-family: var(--font);
            background: var(--bg-body);
            color: var(--text-primary);
            line-height: 1.6;
            padding: 30px 20px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        /* ====== LAYOUT CHÍNH (giống cấu trúc sidebar + main) ====== */
        .main-layout {
            display: flex;
            gap: 30px;
            max-width: 1200px;
            width: 100%;
            align-items: flex-start;
        }

        /* ====== SIDEBAR (dạng thẻ thông tin) ====== */
        .sidebar {
            flex: 0 0 280px;
            background: var(--bg-sidebar);
            border-radius: var(--radius);
            padding: 30px 22px 26px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-light);
            position: sticky;
            top: 30px;
            text-align: center;
        }

        .sidebar-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 16px;
            display: block;
            border: 3px solid var(--accent);
            background: #333;
        }

        .sidebar-name {
            font-size: 1.3rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: var(--text-primary);
        }

        .sidebar-title {
            font-size: 0.85rem;
            font-weight: 400;
            color: var(--accent);
            background: rgba(255, 219, 112, 0.1);
            display: inline-block;
            padding: 4px 14px;
            border-radius: 40px;
            margin: 6px 0 18px;
        }

        .sidebar-divider {
            height: 1px;
            background: var(--border-light);
            margin: 18px 0;
        }

        .sidebar-contact {
            display: flex;
            flex-direction: column;
            gap: 14px;
            text-align: left;
            font-size: 0.82rem;
        }

        .sidebar-contact .item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-secondary);
        }

        .sidebar-contact .item iconify-icon {
            color: var(--accent);
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .sidebar-contact .item a {
            color: var(--text-primary);
            text-decoration: none;
            transition: color 0.2s;
            word-break: break-all;
        }

        .sidebar-contact .item a:hover {
            color: var(--accent);
        }

        .sidebar-contact .label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            display: block;
            margin-bottom: 1px;
        }

        /* Social icons */
        .sidebar-social {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 18px;
            flex-wrap: wrap;
        }

        .sidebar-social a {
            color: var(--text-secondary);
            font-size: 1.4rem;
            transition: color 0.2s, transform 0.2s;
        }

        .sidebar-social a:hover {
            color: var(--accent);
            transform: translateY(-2px);
        }

        /* ====== NỘI DUNG CHÍNH ====== */
        .main-content {
            flex: 1;
            min-width: 0;
        }

        /* Navbar (dạng tab) */
        .navbar {
            background: var(--bg-sidebar);
            border-radius: 40px;
            padding: 6px 10px;
            display: flex;
            gap: 4px;
            margin-bottom: 28px;
            border: 1px solid var(--border-light);
            box-shadow: var(--shadow);
            flex-wrap: wrap;
            justify-content: center;
        }

        .navbar button {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-family: var(--font);
            font-size: 0.85rem;
            font-weight: 500;
            padding: 8px 22px;
            border-radius: 40px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .navbar button:hover {
            color: var(--text-primary);
            background: var(--bg-card);
        }

        .navbar button.active {
            background: var(--accent);
            color: #121212;
            font-weight: 600;
        }

        /* Card chứa nội dung bài viết */
        .article-card {
            background: var(--bg-sidebar);
            border-radius: var(--radius);
            padding: 32px 34px;
            border: 1px solid var(--border-light);
            box-shadow: var(--shadow);
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .article-header {
            margin-bottom: 26px;
        }

        .article-badge {
            display: inline-block;
            background: rgba(255, 219, 112, 0.15);
            color: var(--accent);
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 4px 16px;
            border-radius: 40px;
            margin-bottom: 12px;
        }

        .article-header h1 {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.25;
            letter-spacing: -0.02em;
            margin-bottom: 10px;
        }

        .article-header h1 span {
            color: var(--accent);
        }

        .article-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            font-size: 0.82rem;
            color: var(--text-muted);
            align-items: center;
        }

        .article-meta iconify-icon {
            color: var(--accent);
            margin-right: 4px;
        }

        /* Nội dung bài viết */
        .article-body {
            font-size: 0.95rem;
            color: var(--text-secondary);
        }

        .article-body h2 {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--text-primary);
            margin: 28px 0 12px;
            padding-left: 14px;
            border-left: 4px solid var(--accent);
        }

        .article-body h2:first-of-type {
            margin-top: 0;
        }

        .article-body h3 {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-primary);
            margin: 20px 0 8px;
        }

        .article-body p {
            margin-bottom: 14px;
            text-align: justify;
        }

        .article-body ul,
        .article-body ol {
            margin: 10px 0 16px 20px;
            padding-left: 6px;
        }

        .article-body li {
            margin-bottom: 6px;
        }

        .article-body strong {
            color: var(--text-primary);
            font-weight: 600;
        }

        .article-body a {
            color: var(--accent);
            text-decoration: none;
            border-bottom: 1px dashed rgba(255, 219, 112, 0.4);
            transition: border-color 0.2s;
        }

        .article-body a:hover {
            border-bottom-color: var(--accent);
        }

        /* Highlight box */
        .highlight-box {
            background: var(--bg-card);
            border-left: 4px solid var(--accent);
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
            padding: 16px 22px;
            margin: 20px 0;
            font-size: 0.9rem;
        }

        .highlight-box iconify-icon {
            color: var(--accent);
            margin-right: 8px;
        }

        /* Bảng so sánh */
        .table-wrap {
            overflow-x: auto;
            margin: 18px 0;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-light);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        th {
            background: var(--bg-card);
            color: var(--text-primary);
            font-weight: 600;
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid var(--border-light);
            white-space: nowrap;
        }

        td {
            padding: 11px 16px;
            border-bottom: 1px solid var(--border-light);
            color: var(--text-secondary);
            vertical-align: top;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }

        /* Nhãn phụ lục */
        .badge-pl {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 10px;
            border-radius: 40px;
            background: var(--bg-card);
            color: var(--accent);
            border: 1px solid rgba(255, 219, 112, 0.3);
        }

        /* Danh sách bước */
        .step-list {
            list-style: none;
            margin-left: 0;
            counter-reset: step-counter;
        }

        .step-list li {
            position: relative;
            padding-left: 44px;
            margin-bottom: 16px;
            counter-increment: step-counter;
        }

        .step-list li::before {
            content: counter(step-counter);
            position: absolute;
            left: 0;
            top: 0;
            width: 30px;
            height: 30px;
            background: var(--accent);
            color: #121212;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
        }

        /* Liên kết nguồn */
        .source-note {
            margin-top: 30px;
            padding-top: 18px;
            border-top: 1px solid var(--border-light);
            font-size: 0.78rem;
            color: var(--text-muted);
            display: flex;
            flex-wrap: wrap;
            gap: 10px 20px;
            align-items: center;
        }

        .source-note iconify-icon {
            color: var(--accent);
        }

        /* ====== RESPONSIVE ====== */
        @media (max-width: 820px) {
            .main-layout {
                flex-direction: column;
            }
            .sidebar {
                flex: none;
                width: 100%;
                position: static;
                display: flex;
                flex-wrap: wrap;
                gap: 16px;
                text-align: left;
                padding: 22px 20px;
                align-items: center;
            }
            .sidebar-avatar {
                width: 70px;
                height: 70px;
                margin: 0;
                flex-shrink: 0;
            }
            .sidebar-header {
                flex: 1;
                min-width: 150px;
            }
            .sidebar-name {
                font-size: 1.1rem;
            }
            .sidebar-title {
                font-size: 0.75rem;
                margin: 2px 0 0;
            }
            .sidebar-divider {
                display: none;
            }
            .sidebar-contact {
                flex-direction: row;
                flex-wrap: wrap;
                gap: 10px 20px;
                width: 100%;
                margin-top: 4px;
            }
            .sidebar-social {
                width: 100%;
                justify-content: flex-start;
                margin-top: 4px;
            }
            .navbar {
                border-radius: var(--radius-sm);
            }
            .article-card {
                padding: 22px 18px;
            }
            .article-header h1 {
                font-size: 1.4rem;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 14px 10px;
            }
            .article-card {
                padding: 16px 14px;
            }
            .article-header h1 {
                font-size: 1.2rem;
            }
            .navbar button {
                font-size: 0.75rem;
                padding: 6px 14px;
            }
            .article-body h2 {
                font-size: 1.1rem;
            }
        }
    </style>
